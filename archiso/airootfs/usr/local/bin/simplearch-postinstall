#!/usr/bin/env bash
set -euo pipefail

target="${1:-}"
username="${2:-}"

if [[ -z "$target" || ! -d "$target" ]]; then
    echo "Target root not found: $target" >&2
    exit 1
fi

echo "Preparing Simple Arch defaults for ${username:-created user}."

if arch-chroot "$target" id simplearch >/dev/null 2>&1; then
    arch-chroot "$target" userdel -r simplearch || arch-chroot "$target" userdel simplearch || true
fi

arch-chroot "$target" groupdel simplearch >/dev/null 2>&1 || true
rm -rf \
    "$target/home/simplearch" \
    "$target/etc/plasmalogin.conf" \
    "$target/etc/sddm.conf.d/10-simplearch-live.conf" \
    "$target/etc/sysusers.d/simplearch.conf" \
    "$target/etc/tmpfiles.d/simplearch.conf"

arch-chroot "$target" pacman -Rns --noconfirm calamares >/dev/null 2>&1 || true
rm -f \
    "$target/etc/skel/Desktop/simplearch-install.desktop" \
    "$target/usr/share/applications/calamares.desktop" \
    "$target/usr/share/applications/simplearch-install.desktop"

install -d -m 755 "$target/boot" "$target/etc/mkinitcpio.d"

if [[ ! -r "$target/boot/vmlinuz-linux" ]]; then
    kernel_source=""
    for candidate in \
        "$target"/usr/lib/modules/*/vmlinuz \
        /run/archiso/bootmnt/simplearch/boot/x86_64/vmlinuz-linux \
        /run/archiso/bootmnt/simplearch/boot/vmlinuz-linux \
        /run/archiso/bootmnt/boot/x86_64/vmlinuz-linux \
        /boot/vmlinuz-linux; do
        if [[ -r "$candidate" ]]; then
            kernel_source="$candidate"
            break
        fi
    done

    if [[ -z "$kernel_source" ]]; then
        echo "Could not find a readable linux kernel image for target /boot." >&2
        exit 1
    fi

    install -m 644 "$kernel_source" "$target/boot/vmlinuz-linux"
fi

rm -f "$target/etc/mkinitcpio.conf.d/archiso.conf"

cat > "$target/etc/mkinitcpio.d/linux.preset" <<'EOF'
# mkinitcpio preset file for the linux package

ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux.img"

fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

if [[ -f "$target/etc/mkinitcpio.conf" ]]; then
    modules_line="$(grep -E '^MODULES=' "$target/etc/mkinitcpio.conf" | head -n1 || true)"
else
    modules_line=""
fi

if [[ -z "$modules_line" ]]; then
    modules_line="MODULES=()"
fi

cat > "$target/etc/mkinitcpio.conf" <<EOF
$modules_line
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
EOF

target_lang="$(grep -E '^LANG=' "$target/etc/locale.conf" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
target_lang="${target_lang:-en_US.UTF-8}"
translation_lang="${target_lang%%.*}"
translation_base="${translation_lang%%_*}"

sed -i \
    -e "s/^#\?${target_lang} UTF-8/${target_lang} UTF-8/" \
    -e 's/^#\?en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' \
    "$target/etc/locale.gen"

cat > "$target/etc/vconsole.conf" <<'EOF'
KEYMAP=us
EOF

install -d -m 755 "$target/etc/xdg"
cat > "$target/etc/xdg/plasma-localerc" <<EOF
[Formats]
LANG=$target_lang

[Translations]
LANGUAGE=$translation_lang:$translation_base
EOF

cat > "$target/etc/xdg/kdeglobals" <<EOF
[Locale]
Language=$translation_lang
Languages=$translation_lang,$translation_base

[Translations]
LANGUAGE=$translation_lang:$translation_base
EOF

arch-chroot "$target" locale-gen

if [[ -f "$target/etc/pacman.conf" ]] && ! grep -q '^\[multilib\]' "$target/etc/pacman.conf"; then
    cat >> "$target/etc/pacman.conf" <<'EOF'

[multilib]
Include = /etc/pacman.d/mirrorlist
EOF
fi

mkdir -p "$target/etc/systemd"
cat > "$target/etc/systemd/zram-generator.conf" <<'EOF'
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
EOF

if [[ -n "$username" && -d "$target/home/$username" ]]; then
    arch-chroot "$target" chsh -s /bin/zsh "$username"
    rm -f "$target/home/$username/Desktop/simplearch-install.desktop"

    install -d -m 700 "$target/home/$username/.config"
    cat > "$target/home/$username/.config/plasma-localerc" <<EOF
[Formats]
LANG=$target_lang

[Translations]
LANGUAGE=$translation_lang:$translation_base
EOF
    cat > "$target/home/$username/.config/kdeglobals" <<EOF
[Locale]
Language=$translation_lang
Languages=$translation_lang,$translation_base

[Translations]
LANGUAGE=$translation_lang:$translation_base
EOF
    arch-chroot "$target" chown -R "$username:$username" "/home/$username/.config"
fi

mkdir -p "$target/etc/snapper/configs"
if [[ ! -f "$target/etc/snapper/configs/root" ]]; then
    arch-chroot "$target" snapper -c root create-config / || true
fi

snapper_root="$target/etc/snapper/configs/root"
if [[ -f "$snapper_root" ]]; then
    sed -i \
        -e 's/^ALLOW_USERS=.*/ALLOW_USERS="wheel"/' \
        -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
        -e 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="0"/' \
        -e 's/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="3"/' \
        -e 's/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="0"/' \
        -e 's/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="0"/' \
        -e 's/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY="0"/' \
        "$snapper_root"
fi
